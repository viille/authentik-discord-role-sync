# Discord Developer Portal -> Application -> Bot -> Token
DISCORD_BOT_TOKEN=replace-me
# Discord server ID (developer mode -> Copy Server ID)
DISCORD_GUILD_ID=123456789012345678

# https://authentik.example.com (no slash at the end)
AUTHENTIK_BASE_URL=https://authentik.example.com
# Service account token with read access to users and OAuth source connections
AUTHENTIK_API_TOKEN=replace-me
# Authentik Discord OAuth source slug
AUTHENTIK_DISCORD_SOURCE_SLUG=discord

# Frequency (seconds)
SYNC_INTERVAL_SECONDS=300
# START IN DRY-RUN MODE. Set to false only after reviewing logs.
DRY_RUN=true
# Remove only roles listed in config/roles.json when a guild member has no Discord source link.
REMOVE_UNLINKED=true
# Safety brake: refuse a run requiring more than this many role operations.
MAX_MUTATIONS_PER_RUN=50
# Safety brake: refuse to make changes if fewer than N verified source connections exist.
MIN_LINKED_USERS=1
